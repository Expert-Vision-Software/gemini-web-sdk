{
  "name": "gemini-web-sdk",
  "version": "2.3.0",
  "description": "Unofficial Node.js client for gemini.google.com — inspired by Gemini-API (Python). Supports streaming, chat sessions, gems, file uploads, and TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Expert Vision Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Expert-Vision-Software/gemini-web-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Expert-Vision-Software/gemini-web-sdk/issues"
  },
  "homepage": "https://github.com/Expert-Vision-Software/gemini-web-sdk#readme",
  "keywords": [
    "gemini",
    "google-gemini",
    "gemini-api",
    "nodejs",
    "javascript",
    "typescript",
    "reverse-engineering",
    "chatbot",
    "ai",
    "llm",
    "unofficial"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "tsx test/rid-rcid.test.ts && tsx test/max-response-headers.test.ts"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/follow-redirects": "^1.14.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
